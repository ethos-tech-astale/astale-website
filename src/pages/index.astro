---
import Base from '../layouts/Base.astro';
import Todo from '../components/Todo.astro';
import { site } from '../data/site';
import { getNews, formatDate, isoDate } from '../lib/news';

const latest = (await getNews()).slice(0, 3);
---
<Base title="トップ">
  <h1>{site.name}</h1>
  <p class="lead">静岡県三島市の美術研究所。美大・芸大受験から、おとなの教室・こどもの教室まで。</p>
  {site.line && <p>お問い合わせ・ご見学は<a href={site.line}>公式LINE</a>で。</p>}

  <h2>Art for Life</h2>
  <p>アステール総合美術研究所は1984年4月に静岡県三島市に開校しました。</p>
  <p>以来、芸大美大受験・高校美術科受験対策を始め、年長から中学3年生までを対象とした遊びながら感性を身に付ける体験や、小4から美術・デザインの基礎を学ぶ体験、社会人や大学生などの方を対象とし本格的な作品制作の体験など、これらができる総合美術研究所として活動しております。</p>

  <h2>教室案内</h2>
  <div class="cards">
    <section class="card">
      <h3><a href="/exam">受験生の教室</a></h3>
      <p>芸大美大受験</p>
    </section>
    <section class="card">
      <h3><a href="/kids">こどもの教室</a></h3>
      <p>年中〜小・中学生の絵画造形教室</p>
    </section>
    <section class="card">
      <h3><a href="/basic">基礎の教室</a></h3>
      <p>アート・デザインのプロの基礎</p>
    </section>
    <section class="card">
      <h3><a href="/adult">おとなの教室</a></h3>
      <p>社会人・学生の絵画造形教室</p>
    </section>
  </div>
  <p><a href="/guide">総合案内・学費</a></p>

  <h2>お知らせ</h2>
  {latest.length > 0 ? (
    <ul class="news-list">
      {latest.map((n) => (
        <li>
          <time datetime={isoDate(n.data.date)}>{formatDate(n.data.date)}</time>
          <span class="tag">{n.data.category}</span>
          <a href={`/news/${n.id}`}>{n.data.title}</a>
        </li>
      ))}
    </ul>
  ) : <p>現在お知らせはありません。</p>}
  <p><a href="/news">お知らせ一覧へ</a></p>

  <h2>アクセス</h2>
  <p>{site.address.region}{site.address.locality}{site.address.street}</p>
  {site.access ? <p>{site.access}</p> : <Todo>所在地の番地と駅からの所要時間を src/data/site.ts に入力（Web上の表記を「徒歩◯分」に統一）。地図の埋め込みもここに置く。</Todo>}
</Base>
