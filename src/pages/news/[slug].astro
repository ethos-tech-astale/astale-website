---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { getNews, formatDate, isoDate } from '../../lib/news';

export async function getStaticPaths() {
  const items = await getNews();
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: entry.data.title,
  datePublished: isoDate(entry.data.date),
  publisher: { '@id': `${site.url}/#organization` },
};
---
<Base title={entry.data.title} description={entry.data.summary} jsonLd={jsonLd}>
  <article>
    <p class="meta">
      <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
      <span class="tag">{entry.data.category}</span>
    </p>
    <h1>{entry.data.title}</h1>
    <Content />
  </article>
  <p><a href="/news">お知らせ一覧へ</a></p>
</Base>
