---
import Base from '../layouts/Base.astro';

const interviews = [
  {
    href: '/interview-asakura',
    name: '浅倉 成',
    role: '武蔵野美術大学 2024入学',
    catch: '多摩美・武蔵美・造形大に全勝。その理由とは？',
  },
  {
    href: '/interview-okumura',
    name: '奥村 美海',
    role: 'アーティスト',
    catch: '普通科・油絵未経験から東京藝大 油画専攻へ',
  },
  {
    href: '/interview-sugimoto',
    name: '杉本 陽平',
    role: '映像ディレクター / 企画者',
    catch: '電通出身ディレクターが語る多摩美術大学「合格の裏側」',
  },
  {
    href: '/interview-yamane',
    name: '山根 萌花',
    role: '広告プランナー',
    catch: '3浪して金美合格　不屈の電通のプランナー',
  },
];

const careers = [
  '任天堂 ゲームクリエイター',
  '電通 アートディレクター',
  '博報堂 SIX アートディレクター',
  '日産デザインヨーロッパ カーデザイナー コンセプトカーデザイン',
  '日産自動車 カーデザイナー コンセプトカーデザイン',
  'SUBARU クレイモデラー',
  'Woven Planet Holdings（トヨタグループ）',
  '小松製作所 プロダクトデザイナー',
  '字游工房 書体デザイナー 東京TDC・NY TDC賞他受賞',
  'ターナー カラースパイス',
  'ソニー株式会社 UI・UXデザイナー',
  'キャノン株式会社 プロダクトデザイナー',
  'ワコール ランジェリーデザイナー',
  'コム・デ・ギャルソン ファッションデザイナー',
  'フリーランス映像ディレクター NHK「えいごであそぼ」 スガシカオPV等',
  'アニメーター 「化物語」「斉木楠雄の災難」「ゴールデンカムイ」他',
  '東京藝術大学美術学部版画研究室テクニカルインストラクター',
  '日本大学芸術学部彫刻学科講師 現代美術家 VOCA賞ほか',
  '英国ティーサイド大学講師 写真家',
  'グラフィックデザイナー、ウェブデザイナー、書体デザイナー、漫画家、イラストレーター、現代美術家、彫刻家、陶芸家、染色家',
];
---
<Base title="活躍する卒業生" description="ゲームクリエイター、アートディレクター、カーデザイナー、アーティストなど、さまざまな分野でプロとして活躍するアステールの卒業生と、卒業生インタビューをご紹介します。">
  <h1>活躍する卒業生</h1>

  <h2>卒業生インタビュー</h2>
  <ul>
    {interviews.map((i) => (
      <li>
        <a href={i.href}><strong>{i.name}</strong></a>（{i.role}）<br />
        {i.catch}
      </li>
    ))}
  </ul>

  <h2>大学は通過点。目標はプロ</h2>
  <p>アステールの卒業生の多くがプロとなっており、著名なクリエイターとして様々な分野で活躍しています。その一部をご紹介します。</p>
  <p>（所属会社の規定等により、ご紹介できない著名なクリエイターも多数おります）</p>
  <ul>
    {careers.map((c) => <li>{c}</li>)}
  </ul>
  <p>こちらでご紹介している内容は、卒業生から直接報告を受けた情報などを基にしております。現在の所属とは異なる場合がございます。</p>

  <h2>関連ページ</h2>
  <ul>
    <li><a href="/results">合格実績</a></li>
    <li><a href="/exam">受験生の教室</a></li>
  </ul>
</Base>
